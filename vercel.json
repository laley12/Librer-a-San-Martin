{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/assets/:path*", "destination": "/web/assets/:path*" },
    { "source": "/movil.html", "destination": "/web/movil.html" },
    { "source": "/sw.js", "destination": "/web/sw.js" },
    { "source": "/manifest.webmanifest", "destination": "/web/manifest.webmanifest" },
    { "source": "/icono.svg", "destination": "/web/icono.svg" },
    { "source": "/icono-192.png", "destination": "/web/icono-192.png" },
    { "source": "/icono-512.png", "destination": "/web/icono-512.png" },
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/:path*", "destination": "/web/:path*" }
  ]
}
